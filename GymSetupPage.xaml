<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RouteLab.Controls"
             x:Class="RouteLab.GymSetupPage"
             Title="Dettaglio parete">
    <Grid RowDefinitions="Auto,*">
        <controls:EntityActionBar x:Name="WallActions"
                                  Margin="16,8,16,0"
                                  ContextText="Azioni parete"
                                  AddDescription="Aggiungi pannello"
                                  SaveDescription="Salva parete"
                                  ShowDelete="False"
                                  AddClicked="OnNewPanelClicked"
                                  SaveClicked="OnSaveWallClicked" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Dettaglio parete"
                       FontSize="28"
                       TextColor="{StaticResource WarmGold}"
                       FontFamily="OpenSansSemibold" />
                <Label Text="Seleziona un pannello per modificarne dati, foto e ritaglio."
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="PARETE ATTIVA"
                           FontSize="12"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Sala"
                                   TextColor="{StaticResource MutedText}"
                                   FontSize="12" />
                            <Label x:Name="ActiveRoomContextLabel"
                                   Text="Nessuna sala"
                                   FontSize="18"
                                   TextColor="{StaticResource WarmText}"
                                   FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Parete"
                                   TextColor="{StaticResource MutedText}"
                                   FontSize="12" />
                            <Label x:Name="ActiveWallContextLabel"
                                   Text="Nessuna parete"
                                   FontSize="18"
                                   TextColor="{StaticResource WarmText}"
                                   FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="WallInfoLabel"
                               VerticalOptions="Center"
                               Text="Nessuna parete selezionata."
                               TextColor="{StaticResource MutedText}" />
                        <Button x:Name="ToggleWallEditorButton"
                                Grid.Column="1"
                                Text="Modifica parete"
                                Padding="14,8"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Clicked="OnToggleWallEditorClicked" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource WarmGoldMuted}"
                             Opacity="0.55" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Pannelli"
                               FontSize="20"
                               TextColor="{StaticResource WarmGold}"
                               FontFamily="OpenSansSemibold" />
                        <Label x:Name="PanelsCountLabel"
                               Grid.Column="1"
                               VerticalOptions="Center"
                               Text="0 pannelli"
                               TextColor="{StaticResource MutedText}" />
                    </Grid>
                    <Label Text="Apri un pannello per modificarne dati, fori e immagine."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                    <Label x:Name="PanelsEmptyLabel"
                           Text="Questa parete non contiene ancora pannelli."
                           TextColor="{StaticResource MutedText}" />
                    <VerticalStackLayout x:Name="PanelsHost"
                                         Spacing="10" />

                </VerticalStackLayout>
            </Border>

            <Border x:Name="WallEditorContainer"
                    BackgroundColor="{StaticResource PanelBlackAlt}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16"
                    IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Modifica parete"
                           FontSize="20"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nome parete" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Entry x:Name="WallNameEntry" Placeholder="Nome parete" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Larghezza (mm)" TextColor="{StaticResource MutedText}" FontSize="13" />
                            <Entry x:Name="WallWidthEntry" Placeholder="Larghezza mm" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Altezza (mm)" TextColor="{StaticResource MutedText}" FontSize="13" />
                            <Entry x:Name="WallHeightEntry" Placeholder="Altezza mm" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="PreviewSectionBorder"
                    BackgroundColor="{StaticResource PanelBlack}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Label Text="Anteprima parete"
                               FontSize="20"
                               TextColor="{StaticResource WarmGold}"
                               FontFamily="OpenSansSemibold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="-" Clicked="OnZoomOutClicked" Padding="10,4" />
                        <Button Grid.Column="2" Text="Reset" Clicked="OnZoomResetClicked" Padding="10,4" />
                        <Button Grid.Column="3" Text="+" Clicked="OnZoomInClicked" Padding="10,4" />
                    </Grid>
                    <Grid x:Name="PreviewViewport"
                          HeightRequest="360"
                          SizeChanged="OnPreviewViewportSizeChanged">
                        <ScrollView Orientation="Both">
                            <AbsoluteLayout x:Name="PreviewLayer">
                                <GraphicsView x:Name="PreviewCanvas"
                                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                                              AbsoluteLayout.LayoutFlags="All">
                                    <GraphicsView.GestureRecognizers>
                                        <PinchGestureRecognizer PinchUpdated="OnPreviewPinchUpdated" />
                                        <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnPreviewDoubleTapped" />
                                    </GraphicsView.GestureRecognizers>
                                </GraphicsView>
                                <AbsoluteLayout x:Name="PanelImagesLayer"
                                                InputTransparent="True"
                                                AbsoluteLayout.LayoutBounds="0,0,1,1"
                                                AbsoluteLayout.LayoutFlags="All" />
                            </AbsoluteLayout>
                        </ScrollView>
                    </Grid>
                    <Label Text="Il pannello selezionato è evidenziato. Doppio tap per azzerare lo zoom."
                           FontSize="12"
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource PanelBlack}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Mapping hardware"
                           FontSize="20"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />
                    <Label Text="Configura l'associazione tra i fori della parete e i LED."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                    <Button x:Name="OpenHardwareMappingButton"
                            Text="Apri mapping hardware"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Clicked="OnOpenHardwareMappingClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
