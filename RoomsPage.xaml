<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RouteLab.Controls"
             x:Class="RouteLab.RoomsPage"
             Title="Sale">
    <Grid RowDefinitions="Auto,*">
        <controls:EntityActionBar Margin="16,8,16,0"
                                  ContextText="Azioni sale"
                                  AddDescription="Nuova sala"
                                  ShowSave="False"
                                  ShowDelete="False"
                                  AddClicked="OnAddRoomClicked" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Sale"
                       FontSize="30"
                       TextColor="{StaticResource WarmGold}"
                       FontFamily="OpenSansSemibold" />
                <Label Text="Seleziona una sala disponibile per aprire le sue pareti."
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sale disponibili"
                           FontSize="18"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />
                    <Label x:Name="RoomsEmptyLabel"
                           Text="Non ci sono sale. Creane una da Settings > Sala."
                           TextColor="{StaticResource MutedText}" />
                    <VerticalStackLayout x:Name="RoomsHost"
                                         Spacing="10" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
