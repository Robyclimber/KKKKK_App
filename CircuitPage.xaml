<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RouteLab.Controls"
             x:Class="RouteLab.CircuitPage"
             Title="Circuiti">
    <Grid RowDefinitions="Auto,*">
        <controls:EntityActionBar x:Name="CircuitActions"
                                  Margin="16,8,16,0"
                                  ContextText="Azioni circuito"
                                  AddDescription="Nuovo circuito"
                                  SaveDescription="Salva circuito"
                                  DeleteDescription="Elimina circuito"
                                  AddClicked="OnNewCircuitClicked"
                                  SaveClicked="OnSaveCircuitClicked"
                                  DeleteClicked="OnDeleteCircuitClicked" />

        <ScrollView x:Name="CircuitPageScrollView"
                    Grid.Row="1">
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Circuiti"
                       FontSize="30"
                       TextColor="{StaticResource WarmGold}"
                       FontFamily="OpenSansSemibold"
                       CharacterSpacing="6"
                       LineBreakMode="NoWrap" />
                <VerticalStackLayout Spacing="4">
                    <Label Text="Sala" FontSize="13" TextColor="{StaticResource MutedText}" />
                    <Picker x:Name="CircuitRoomPicker"
                            Title="Seleziona una sala"
                            SelectedIndexChanged="OnCircuitRoomChanged" />
                </VerticalStackLayout>
                <Label x:Name="CurrentWallLabel"
                       Text="Nessuna parete disponibile."
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGold}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="WorkflowTitleLabel"
                           Text="Circuiti"
                           FontSize="20"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />
                    <Label x:Name="WorkflowMessageLabel"
                           Text="Seleziona una sala per vedere i circuiti disponibili."
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Circuiti della sala"
                                   FontSize="20"
                                   TextColor="{StaticResource WarmGold}"
                                   FontFamily="OpenSansSemibold" />
                            <Label Text="Apri un circuito esistente oppure creane uno nuovo."
                                   FontSize="12"
                                   TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Label x:Name="CircuitsCountLabel"
                               Grid.Column="1"
                               VerticalOptions="Center"
                               Text="0 circuiti"
                               TextColor="{StaticResource MutedText}" />
                    </Grid>
                    <Label x:Name="CircuitsEmptyLabel"
                           Text="Nessun circuito presente in questa sala."
                           TextColor="{StaticResource MutedText}" />
                    <VerticalStackLayout x:Name="CircuitsHost" Spacing="10" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CircuitEditorSection"
                    IsVisible="False"
                    BackgroundColor="{StaticResource PanelBlackAlt}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Editor circuito" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                            <Label Text="Associa una o piu pareti e scegli quella attiva per disegnare i movimenti."
                                   FontSize="12"
                                   TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="#2B2418"
                                Stroke="{StaticResource WarmGoldMuted}"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,6"
                                VerticalOptions="Start">
                            <Label x:Name="EditorModeLabel"
                                   Text="Nuovo circuito"
                                   FontSize="12"
                                   TextColor="{StaticResource WarmText}"
                                   FontFamily="OpenSansSemibold" />
                        </Border>
                    </Grid>
                    <Border BackgroundColor="#17130D"
                            Stroke="#8E7531"
                            StrokeShape="RoundRectangle 14"
                            Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Stato corrente"
                                   FontSize="12"
                                   TextColor="{StaticResource MutedText}" />
                            <Label x:Name="CircuitSummaryLabel"
                                   Text="Nessun circuito selezionato."
                                   FontSize="13"
                                   TextColor="{StaticResource WarmText}" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Pareti del circuito" FontSize="13" TextColor="{StaticResource MutedText}" />
                        <VerticalStackLayout x:Name="CircuitWallSelectionHost" Spacing="6" />
                        <Label Text="Parete attiva nell'editor"
                               Margin="0,4,0,0"
                               FontSize="13"
                               TextColor="{StaticResource MutedText}" />
                        <Picker x:Name="CircuitWallPicker"
                                Title="Seleziona la parete da modificare"
                                ItemDisplayBinding="{Binding DisplayLabel}"
                                SelectedIndexChanged="OnCircuitWallChanged" />
                    </VerticalStackLayout>
                    <Border BackgroundColor="{StaticResource PanelBlack}" Stroke="#3A3120" StrokeShape="RoundRectangle 14" Padding="12">
                        <VerticalStackLayout Spacing="12">
                             <Label Text="Identita circuito"
                                    FontSize="13"
                                    TextColor="{StaticResource WarmGold}"
                                    FontFamily="OpenSansSemibold" />
                             <Entry x:Name="CircuitNameEntry" Placeholder="Nome circuito" />
                              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                 <VerticalStackLayout Spacing="4">
                                     <Label Text="Difficolta" FontSize="12" TextColor="{StaticResource MutedText}" />
                                     <Picker x:Name="CircuitDifficultyPicker"
                                             Title="Seleziona grado"
                                             SelectedIndexChanged="OnCircuitDifficultyChanged" />
                                 </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Inclinazione (+ strapiombo)" FontSize="12" TextColor="{StaticResource MutedText}" />
                                     <Entry x:Name="CircuitInclinationEntry" Placeholder="20" Keyboard="Numeric" />
                                 </VerticalStackLayout>
                             </Grid>
                          </VerticalStackLayout>
                     </Border>
                    <Border BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 14" Padding="12">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Globali circuito" FontSize="16" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                                    <Label Text="Override salvati nel singolo circuito. I nuovi circuiti partono dai default di Settings."
                                           FontSize="12"
                                           TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                                <Button x:Name="ToggleGlobalsButton"
                                        Grid.Column="1"
                                        Text="Nascondi"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Clicked="OnToggleGlobalsClicked" />
                            </Grid>
                            <VerticalStackLayout x:Name="CircuitGlobalsEditorHost" Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Button Text="Usa default app"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Clicked="OnApplyAppDefaultsToCircuitClicked" />
                                    <Label Grid.Column="1"
                                           Text="Ricarica i valori di Settings dentro questo circuito prima di salvare."
                                           FontSize="12"
                                           TextColor="{StaticResource MutedText}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Preset name" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Entry x:Name="CircuitPresetNameEntry" Placeholder="default" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Effect" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Entry x:Name="CircuitEffectEntry" Placeholder="steady" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Default brightness" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Entry x:Name="CircuitDefaultBrightnessEntry" Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Dimmed brightness" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Entry x:Name="CircuitDimmedBrightnessEntry" Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Colore mano destra" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <BoxView x:Name="CircuitRightHandColorPreview" WidthRequest="28" HeightRequest="28" CornerRadius="8" VerticalOptions="Center" />
                                            <Label x:Name="CircuitRightHandColorValueLabel" Grid.Column="1" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="Scegli" Clicked="OnPickCircuitRightHandColorClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Colore mano sinistra" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <BoxView x:Name="CircuitLeftHandColorPreview" WidthRequest="28" HeightRequest="28" CornerRadius="8" VerticalOptions="Center" />
                                            <Label x:Name="CircuitLeftHandColorValueLabel" Grid.Column="1" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="Scegli" Clicked="OnPickCircuitLeftHandColorClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Colore start" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <BoxView x:Name="CircuitStartColorPreview" WidthRequest="28" HeightRequest="28" CornerRadius="8" VerticalOptions="Center" />
                                            <Label x:Name="CircuitStartColorValueLabel" Grid.Column="1" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="Scegli" Clicked="OnPickCircuitStartColorClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Colore top" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <BoxView x:Name="CircuitTopColorPreview" WidthRequest="28" HeightRequest="28" CornerRadius="8" VerticalOptions="Center" />
                                            <Label x:Name="CircuitTopColorValueLabel" Grid.Column="1" VerticalOptions="Center" />
                                            <Button Grid.Column="2" Text="Scegli" Clicked="OnPickCircuitTopColorClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border BackgroundColor="{StaticResource PanelBlackAlt}"
                                        Stroke="{StaticResource WarmGoldMuted}"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="12">
                                    <VerticalStackLayout Spacing="10">
                                        <Label Text="Selettore colore circuito"
                                               FontSize="15"
                                               TextColor="{StaticResource WarmGold}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label x:Name="CircuitColorPickerTargetLabel"
                                               Text="Seleziona un colore da modificare."
                                               TextColor="{StaticResource MutedText}"
                                               FontSize="12" />
                                        <BoxView x:Name="CircuitColorPickerPreview"
                                                 HeightRequest="32"
                                                 CornerRadius="10" />
                                        <VerticalStackLayout Spacing="4">
                                            <Label x:Name="CircuitRedValueLabel" Text="Rosso: 0" TextColor="{StaticResource MutedText}" FontSize="12" />
                                            <Slider x:Name="CircuitRedSlider" Minimum="0" Maximum="255" ValueChanged="OnCircuitColorSliderChanged" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="4">
                                            <Label x:Name="CircuitGreenValueLabel" Text="Verde: 0" TextColor="{StaticResource MutedText}" FontSize="12" />
                                            <Slider x:Name="CircuitGreenSlider" Minimum="0" Maximum="255" ValueChanged="OnCircuitColorSliderChanged" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="4">
                                            <Label x:Name="CircuitBlueValueLabel" Text="Blu: 0" TextColor="{StaticResource MutedText}" FontSize="12" />
                                            <Slider x:Name="CircuitBlueSlider" Minimum="0" Maximum="255" ValueChanged="OnCircuitColorSliderChanged" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Blink count" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Entry x:Name="CircuitBlinkCountEntry" Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Blink period ms" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Entry x:Name="CircuitBlinkPeriodMsEntry" Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                                        <Label Text="Hold duration ms" FontSize="13" TextColor="{StaticResource MutedText}" />
                                        <Entry x:Name="CircuitHoldDurationMsEntry" Keyboard="Numeric" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Button x:Name="LaunchCircuitButton"
                            Text="Avvia"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Clicked="OnLaunchCircuitClicked" />
                    <Button x:Name="OpenNextHoldSuggestionButton"
                            Text="Genera presa successiva"
                            Clicked="OnOpenNextHoldSuggestionClicked" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CircuitInteractionSection"
                    IsVisible="False"
                    BackgroundColor="{StaticResource PanelBlack}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Modalita selezione movimento" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
                        <Button x:Name="SelectModeButton" Text="Sel" Clicked="OnSelectModeClicked" />
                        <Button x:Name="RightHandModeButton" Grid.Column="1" Text="DX" Clicked="OnRightHandModeClicked" />
                        <Button x:Name="LeftHandModeButton" Grid.Column="2" Text="SX" Clicked="OnLeftHandModeClicked" />
                        <Button x:Name="StartModeButton" Grid.Column="3" Text="S" Clicked="OnStartModeClicked" />
                        <Button x:Name="TopModeButton" Grid.Column="4" Text="T" Clicked="OnTopModeClicked" />
                        <Button x:Name="SimulationModeButton" Grid.Column="5" Text="Simula" Clicked="OnSimulationModeClicked" />
                    </Grid>
                    <Button x:Name="FeetModeButton"
                            Text="Piedi"
                            Clicked="OnFeetModeClicked" />
                    <Button x:Name="RemoveModeButton"
                            Text="Rimuovi"
                            Clicked="OnRemoveModeClicked"
                            BackgroundColor="{StaticResource Danger}"
                            TextColor="White" />
                    <Label x:Name="InteractionHintLabel"
                           Text="Posiziona i due start, poi scegli DX o SX per il primo movimento: i successivi alternano automaticamente la mano."
                           FontSize="12"
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="CircuitPreviewSection"
                    IsVisible="False"
                    BackgroundColor="{StaticResource PanelBlackAlt}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Label Text="Parete attiva e fori" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="-" Clicked="OnZoomOutClicked" Padding="10,4" />
                        <Button Grid.Column="2" Text="Reset" Clicked="OnZoomResetClicked" Padding="10,4" />
                        <Button Grid.Column="3" Text="+" Clicked="OnZoomInClicked" Padding="10,4" />
                    </Grid>
                    <Grid x:Name="PreviewViewport" HeightRequest="420" SizeChanged="OnPreviewViewportSizeChanged">
                        <ScrollView Orientation="Both">
                            <AbsoluteLayout x:Name="CircuitPreviewLayer">
                                <GraphicsView x:Name="CircuitPreviewCanvas"
                                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                                              AbsoluteLayout.LayoutFlags="All">
                                    <GraphicsView.GestureRecognizers>
                                        <PinchGestureRecognizer PinchUpdated="OnPreviewPinchUpdated" />
                                        <TapGestureRecognizer Tapped="OnPreviewSingleTapped" />
                                        <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnPreviewDoubleTappedForLeftHand" />
                                        <TapGestureRecognizer NumberOfTapsRequired="3" Tapped="OnPreviewTripleTappedToRemove" />
                                    </GraphicsView.GestureRecognizers>
                                </GraphicsView>
                                <AbsoluteLayout x:Name="CircuitPanelImagesHost"
                                                InputTransparent="True"
                                                AbsoluteLayout.LayoutBounds="0,0,1,1"
                                                AbsoluteLayout.LayoutFlags="All" />
                            </AbsoluteLayout>
                        </ScrollView>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="14" HeightRequest="14" Color="#C44536" />
                            <Label Text="Mov. DX" FontSize="12" TextColor="{StaticResource MutedText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                            <BoxView WidthRequest="14" HeightRequest="14" Color="#247BA0" />
                            <Label Text="Mov. SX" FontSize="12" TextColor="{StaticResource MutedText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="2" Spacing="6">
                            <BoxView WidthRequest="14" HeightRequest="14" Color="#2E8B57" />
                            <Label Text="Start" FontSize="12" TextColor="{StaticResource MutedText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="3" Spacing="6">
                            <BoxView WidthRequest="14" HeightRequest="14" Color="#F2C94C" />
                            <Label Text="Top" FontSize="12" TextColor="{StaticResource MutedText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="4" Spacing="6">
                            <BoxView WidthRequest="14" HeightRequest="14" Color="#7FDBFF" />
                            <Label Text="Piedi" FontSize="12" TextColor="{StaticResource MutedText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Label x:Name="SelectedHoleInfoLabel"
                           Text="Nessun foro selezionato."
                           FontSize="12"
                           TextColor="{StaticResource MutedText}" />
                     <VerticalStackLayout x:Name="SelectedHoleActionsHost" Spacing="8" IsVisible="False">
                        <Label Text="Azioni rapide sul foro selezionato"
                               FontSize="13"
                               TextColor="{StaticResource WarmGold}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button x:Name="QuickRightButton" Text="DX" Clicked="OnQuickRightClicked" />
                            <Button x:Name="QuickLeftButton" Grid.Column="1" Text="SX" Clicked="OnQuickLeftClicked" />
                            <Button x:Name="QuickFeetButton" Grid.Column="2" Text="Piedi" Clicked="OnQuickFeetClicked" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="QuickStartRightButton" Text="Start DX" Clicked="OnQuickStartRightClicked" />
                            <Button x:Name="QuickStartLeftButton" Grid.Column="1" Text="Start SX" Clicked="OnQuickStartLeftClicked" />
                        </Grid>
                         <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                             <Button x:Name="QuickTopRightButton" Text="Top DX" Clicked="OnQuickTopRightClicked" />
                             <Button x:Name="QuickTopLeftButton" Grid.Column="1" Text="Top SX" Clicked="OnQuickTopLeftClicked" />
                         </Grid>
                         <Button x:Name="QuickRemoveButton"
                                 Text="Rimuovi"
                                 Clicked="OnQuickRemoveClicked"
                                 BackgroundColor="{StaticResource Danger}"
                                 TextColor="White" />
                     </VerticalStackLayout>
                 </VerticalStackLayout>
             </Border>

            <Border x:Name="CircuitMovementsSection"
                    IsVisible="False"
                    BackgroundColor="{StaticResource PanelBlack}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Movimenti circuito" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <Label x:Name="MovementsEmptyLabel"
                           Text="Nessun movimento nel circuito selezionato."
                           TextColor="{StaticResource MutedText}" />
                    <VerticalStackLayout x:Name="MovementsHost" Spacing="10" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
