<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteLab.HardwareMappingPage"
             Title="Mapping hardware della parete">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="SaveToolbarItem"
                     Text="Salva"
                     IconImageSource="save.svg"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnSaveWallClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="RouteLab"
                       FontSize="28"
                       TextColor="{StaticResource WarmGold}"
                       FontFamily="OpenSansSemibold"
                       CharacterSpacing="2"
                       LineBreakMode="NoWrap" />
                <Label Text="Configura il mapping hardware della parete: fori, pointId e LED."
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Seleziona la parete" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sala selezionata" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Picker x:Name="RoomsPicker"
                                Title="Seleziona una sala"
                                ItemDisplayBinding="{Binding DisplayLabel}"
                                SelectedIndexChanged="OnRoomSelectionChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Parete selezionata" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Picker x:Name="WallsPicker"
                                Title="Seleziona una parete"
                                ItemDisplayBinding="{Binding DisplayLabel}"
                                SelectedIndexChanged="OnWallSelectionChanged" />
                    </VerticalStackLayout>
                    <Label x:Name="WallInfoLabel"
                           Text="Nessuna parete selezionata."
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Mapping hardware della parete" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <Label Text="La numerazione LED è unica per tutta la parete e percorre verticalmente i pannelli senza ripartire da 1."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                    <Label Text="Per segnare un foro guasto, disattiva l'interruttore Funzionante: la scelta viene salvata subito e quel foro non potrà essere usato nei circuiti o nella simulazione."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Verso iniziale della parete"
                               TextColor="{StaticResource MutedText}"
                               FontSize="13" />
                        <Picker x:Name="WallLedDirectionPicker"
                                Title="Scegli il verso verticale"
                                SelectedIndexChanged="OnWallLedDirectionChanged" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Text="Genera numerazione LED globale"
                                Clicked="OnAutoMapHoleLedsClicked" />
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="8"
                                               VerticalOptions="Center">
                            <Label Text="Solo conflitti"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource MutedText}" />
                            <Switch x:Name="ShowOnlyHoleConflictsSwitch"
                                    Toggled="OnShowOnlyHoleConflictsToggled" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Border BackgroundColor="#282217" Stroke="#B9922F" StrokeShape="RoundRectangle 10" Padding="10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Procedura ordine manuale dei fori"
                                   TextColor="{StaticResource WarmGold}"
                                   FontFamily="OpenSansSemibold" />
                            <Label x:Name="ManualOrderStatusLabel"
                                   TextColor="{StaticResource MutedText}"
                                   FontSize="12" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Azzera e ricomincia"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Clicked="OnClearManualOrderClicked" />
                                <Button Grid.Column="1"
                                        Text="Mostra ordine manuale"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Clicked="OnShowManualOrderClicked" />
                            </Grid>
                            <Button x:Name="OpenManualOrderImageButton"
                                    Text="Apri immagine zoomabile per definire l'ordine"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Clicked="OnOpenManualOrderImageClicked" />
                            <Grid x:Name="ManualOrderImageControls" IsVisible="False" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Text="Parete: definisci l'ordine"
                                       TextColor="{StaticResource WarmGold}"
                                       FontFamily="OpenSansSemibold"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="-" Padding="10,4" Clicked="OnManualOrderZoomOutClicked" />
                                <Button Grid.Column="2" Text="Reset" Padding="10,4" Clicked="OnManualOrderZoomResetClicked" />
                                <Button Grid.Column="3" Text="+" Padding="10,4" Clicked="OnManualOrderZoomInClicked" />
                            </Grid>
                            <Grid x:Name="ManualOrderViewport" IsVisible="False" HeightRequest="420" SizeChanged="OnManualOrderViewportSizeChanged">
                                <ScrollView Orientation="Both">
                                    <AbsoluteLayout x:Name="ManualOrderLayer">
                                        <GraphicsView x:Name="ManualOrderCanvas"
                                                      AbsoluteLayout.LayoutBounds="0,0,1,1"
                                                      AbsoluteLayout.LayoutFlags="All">
                                            <GraphicsView.GestureRecognizers>
                                                <PinchGestureRecognizer PinchUpdated="OnManualOrderPinchUpdated" />
                                                <TapGestureRecognizer Tapped="OnManualOrderHoleTapped" />
                                            </GraphicsView.GestureRecognizers>
                                        </GraphicsView>
                                        <AbsoluteLayout x:Name="ManualOrderPanelImagesHost"
                                                        InputTransparent="True"
                                                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                                                        AbsoluteLayout.LayoutFlags="All" />
                                    </AbsoluteLayout>
                                </ScrollView>
                            </Grid>
                            <Label x:Name="ManualOrderSelectedHoleLabel"
                                   IsVisible="False"
                                   Text="Ingrandisci con due dita, poi tocca il foro da assegnare al prossimo numero."
                                   TextColor="{StaticResource MutedText}"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="Aggiorna elenco"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Clicked="OnRefreshClicked" />
                    <Label x:Name="HoleMappingEmptyLabel"
                           Text="Nessun foro disponibile."
                           TextColor="{StaticResource MutedText}" />
                    <Label x:Name="HoleMappingSummaryLabel"
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                    <VerticalStackLayout x:Name="HoleMappingsHost" Spacing="10" />
                    <Button x:Name="LoadMoreHoleMappingsButton"
                            Text="Carica altri fori"
                            IsVisible="False"
                            Clicked="OnLoadMoreHoleMappingsClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
