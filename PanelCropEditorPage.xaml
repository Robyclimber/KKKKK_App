<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteLab.PanelCropEditorPage"
             Title="Editor 4 punti">

    <Grid Padding="16"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="10">
        <Label Grid.Row="0"
               x:Name="CropInfoLabel"
               Text="Editor prospettico a 4 punti"
               FontSize="22"
               TextColor="{StaticResource WarmGold}"
               FontFamily="OpenSansSemibold" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="10">
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10">
                <Button Grid.Row="0"
                        Grid.Column="0"
                        Text="Zoom -"
                        Clicked="OnZoomOutClicked" />
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Text="Zoom +"
                        Clicked="OnZoomInClicked" />
                <Button Grid.Row="1"
                        Grid.Column="0"
                        Text="Reset vista"
                        Clicked="OnResetViewportClicked" />
                <Button Grid.Row="1"
                        Grid.Column="1"
                        Text="Reset geometria"
                        Clicked="OnResetGeometryClicked" />
                <Button Grid.Row="2"
                        Grid.Column="0"
                        Text="Annulla"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Clicked="OnCancelClicked" />
                <Button x:Name="ConfirmButton"
                        Grid.Row="2"
                        Grid.Column="1"
                        Text="Conferma e usa"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Clicked="OnConfirmClicked" />
            </Grid>
            <Label x:Name="ZoomLabel"
                   Text="Zoom: 100%"
                   TextColor="{StaticResource MutedText}" />
        </VerticalStackLayout>

        <Border Grid.Row="2"
                x:Name="EditorViewport"
                BackgroundColor="#101820"
                StrokeShape="RoundRectangle 18"
                Padding="0"
                Margin="0,6,0,0">
            <Grid x:Name="EditorHost">
                <GraphicsView x:Name="EditorGraphicsView"
                              StartInteraction="OnStartInteraction"
                              DragInteraction="OnDragInteraction"
                              EndInteraction="OnEndInteraction" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
