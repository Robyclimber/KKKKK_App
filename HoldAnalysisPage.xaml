<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RuoteLab.HoldAnalysisPage"
             Title="Analisi prese">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="PageTitleLabel"
                       Text="Analisi prese"
                       FontSize="28"
                       TextColor="{StaticResource WarmGold}"
                       FontFamily="OpenSansSemibold" />
                <Label x:Name="PageSubtitleLabel"
                       Text="Rivedi i fori della parete e assegna manualmente la presa usando il ritaglio immagine."
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Flusso"
                           FontSize="18"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />
                    <Label Text="Per ogni foro puoi lasciare vuoto oppure indicare dimensione e tipo della presa. Il ritaglio e' centrato sul foro selezionato."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Applica suggerimenti iniziali"
                                Clicked="OnApplySuggestionsClicked" />
                        <Button Grid.Column="1"
                                Text="Salva prese parete"
                                Clicked="OnSaveClicked" />
                    </Grid>
                    <Label x:Name="RenderProgressLabel"
                           Text="Fori caricati: 0"
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="HolesHost" Spacing="12" />

            <Button x:Name="LoadMoreButton"
                    Text="Carica altri fori"
                    Clicked="OnLoadMoreClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
