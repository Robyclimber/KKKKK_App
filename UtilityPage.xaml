<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteLab.UtilityPage"
             Title="Utility">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salva impostazioni RouteLab Hub"
                     IconImageSource="save.svg"
                     Order="Primary"
                     Priority="0"
                     Clicked="OnSaveEsp32SettingsClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Utility"
                       FontSize="30"
                       TextColor="{StaticResource WarmGold}"
                       FontFamily="OpenSansSemibold"
                       CharacterSpacing="6"
                       LineBreakMode="NoWrap" />
                <Label Text="Azioni tecniche e manutenzione dell'app."
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="RouteLab Hub" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <Label Text="Pannello tecnico per configurare e verificare il controller della parete."
                           TextColor="{StaticResource MutedText}" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Base URL dispositivo" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Entry x:Name="Esp32BaseUrlEntry" Placeholder="http://192.168.1.50" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Controller ID" TextColor="{StaticResource MutedText}" FontSize="13" />
                            <Entry x:Name="Esp32ControllerIdEntry" Placeholder="routelab-hub-sala-1" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="LED parete" TextColor="{StaticResource MutedText}" FontSize="13" />
                            <Entry x:Name="Esp32WallLedCountEntry" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Brightness limit" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Entry x:Name="Esp32BrightnessLimitEntry" Keyboard="Numeric" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Health" Clicked="OnEsp32HealthClicked" />
                        <Button Grid.Column="1" Text="Status" Clicked="OnEsp32StatusClicked" />
                    </Grid>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Scritta matrice LED" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry x:Name="SignTextEntry"
                                   Placeholder="Scrivi una frase (max 80 caratteri)"
                                   MaxLength="80"
                                   ReturnType="Send"
                                   Completed="OnSendSignTextClicked" />
                            <Button Grid.Column="1" Text="Mostra" Clicked="OnSendSignTextClicked" />
                        </Grid>
                        <Label Text="Fino a due lettere restano fisse; le frasi più lunghe scorrono sulla matrice 5×8."
                               TextColor="{StaticResource MutedText}"
                               FontSize="12" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Parete da sincronizzare" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Picker x:Name="Esp32WallPicker"
                                Title="Seleziona parete"
                                ItemDisplayBinding="{Binding DisplayLabel}"
                                SelectedIndexChanged="OnEsp32WallSelectionChanged" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Circuito da mostrare" TextColor="{StaticResource MutedText}" FontSize="13" />
                        <Picker x:Name="Esp32CircuitPicker"
                                Title="Seleziona circuito"
                                ItemDisplayBinding="{Binding DisplayLabel}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Invia config parete"
                                Clicked="OnSendWallConfigClicked" />
                        <Button Grid.Column="1"
                                Text="Invia e sostituisci circuiti"
                                Clicked="OnSyncCircuitsClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Invia circuiti editoriali"
                                Clicked="OnSyncEditorialCircuitsClicked" />
                        <Button Grid.Column="1"
                                Text="Importa circuiti da RouteLab Hub"
                                Clicked="OnImportEditorialCircuitsClicked" />
                    </Grid>
                    <Label Text="Attenzione: Sync circuiti sovrascrive i circuiti gia' presenti sul dispositivo per la parete selezionata."
                           TextColor="{StaticResource WarmGold}"
                           FontSize="12" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Show circuito"
                                Clicked="OnShowCircuitClicked" />
                        <Button Grid.Column="1"
                                Text="Stop circuito"
                                Clicked="OnStopCircuitClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Reset circuito"
                                Clicked="OnResetCircuitClicked" />
                        <Button Grid.Column="1"
                                Text="Clear LED"
                                Clicked="OnClearCircuitClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Test random LED"
                                Clicked="OnRandomSequenceTestClicked" />
                        <Button Grid.Column="1"
                                Text="Stop test random"
                                Clicked="OnStopRandomSequenceTestClicked" />
                    </Grid>
                    <Label Text="Verifica cablaggio: accende simultaneamente tutti i LED configurati. Usa Clear LED per spegnerli."
                           TextColor="{StaticResource WarmGold}"
                           FontSize="12" />
                    <Button Text="Accendi tutti i LED"
                            Clicked="OnAllLedsTestClicked" />
                    <Label Text="Assunzione attuale: ogni foro viene esportato su LED progressivo in ordine foro, partendo da 0."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                    <Label x:Name="Esp32StatusLabel"
                           Text="Nessuna chiamata a RouteLab Hub eseguita."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Reset database" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <Label Text="Cancella sale, pareti, pannelli, fori e circuiti salvati. Usalo solo quando vuoi ripartire completamente da zero."
                           TextColor="{StaticResource MutedText}" />
                    <Button Text="Resetta tutto il DB"
                            Clicked="OnResetDatabaseClicked"
                            BackgroundColor="{StaticResource Danger}"
                            TextColor="{StaticResource WarmText}" />
                    <Label x:Name="ResetStatusLabel"
                           Text="Nessun reset eseguito."
                           TextColor="{StaticResource MutedText}"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
