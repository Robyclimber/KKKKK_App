<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RouteLab.Controls"
             x:Class="RouteLab.WallsPage"
             Title="Pareti">
    <Grid RowDefinitions="Auto,*">
        <controls:EntityActionBar x:Name="WallsActions"
                                  Margin="16,8,16,0"
                                  ContextText="Azioni pareti"
                                  AddDescription="Nuova parete"
                                  ShowSave="False"
                                  ShowDelete="False"
                                  AddClicked="OnNewWallClicked" />

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Pareti"
                       FontSize="30"
                       TextColor="{StaticResource WarmGold}"
                       FontFamily="OpenSansSemibold" />
                <Label Text="Seleziona una parete della sala oppure aggiungine una nuova."
                       TextColor="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}"
                    Stroke="{StaticResource WarmGoldMuted}"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Pareti della sala"
                           FontSize="18"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />
                    <Label x:Name="SelectedRoomLabel"
                           Text="Nessuna sala selezionata."
                           TextColor="{StaticResource WarmText}" />
                    <Label x:Name="WallsSummaryLabel"
                           Text="0 pareti"
                           TextColor="{StaticResource MutedText}" />
                    <Label x:Name="WallsEmptyLabel"
                           Text="Non ci sono ancora pareti."
                           TextColor="{StaticResource MutedText}" />
                    <VerticalStackLayout x:Name="WallsHost"
                                         Spacing="10" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
