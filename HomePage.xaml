<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RouteLab.HomePage"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Grid ColumnDefinitions="76,*"
                  ColumnSpacing="14">
                <Image Source="routelab_mark.svg"
                       WidthRequest="76"
                       HeightRequest="76"
                       Aspect="AspectFit"
                       SemanticProperties.Description="Simbolo RouteLab" />
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     VerticalOptions="Center">
                    <Label Text="RouteLab"
                           FontSize="30"
                           FontFamily="OpenSansSemibold"
                           CharacterSpacing="2"
                           LineBreakMode="NoWrap"
                           TextColor="{StaticResource WarmGold}" />
                    <Label Text="Configurazione palestra, circuiti e allenamento."
                           TextColor="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="NextStepTitleLabel"
                           Text="Prossimo passo"
                           FontSize="22"
                           TextColor="{StaticResource WarmGold}"
                           FontFamily="OpenSansSemibold" />
                    <Label x:Name="NextStepMessageLabel"
                           Text="Controllo lo stato della palestra..."
                           TextColor="{StaticResource MutedText}" />
                    <Button x:Name="PrimaryActionButton"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Text="Vai a sale e pareti"
                            Clicked="OnPrimaryActionClicked" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Azioni rapide" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Sale e pareti"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Clicked="OnGoToGymSetupClicked" />
                        <Button Grid.Column="1"
                                Text="Circuiti"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Clicked="OnGoToCircuitsClicked" />
                    </Grid>
                    <Button Text="Allenamento"
                            Clicked="OnTrainingClicked"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource PanelBlackAlt}" Stroke="{StaticResource WarmGoldMuted}" StrokeShape="RoundRectangle 18" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Stato attuale" FontSize="20" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGoldMuted}" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Sale" TextColor="{StaticResource MutedText}" FontSize="12" />
                                <Label x:Name="RoomsCountLabel" Text="0" FontSize="24" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGoldMuted}" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Pareti" TextColor="{StaticResource MutedText}" FontSize="12" />
                                <Label x:Name="WallsCountLabel" Text="0" FontSize="24" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="{StaticResource PanelBlack}" Stroke="{StaticResource WarmGoldMuted}" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Circuiti" TextColor="{StaticResource MutedText}" FontSize="12" />
                                <Label x:Name="CircuitsCountLabel" Text="0" FontSize="24" TextColor="{StaticResource WarmGold}" FontFamily="OpenSansSemibold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

